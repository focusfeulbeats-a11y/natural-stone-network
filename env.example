# Copy this file to .env and adjust as needed.

# Port the API listens on
PORT=4000

# Secret used to sign auth tokens — change this to a long random string in production
AUTH_SECRET=change-this-to-a-long-random-string

# Path to the SQLite database file (relative to backend/)
DB_PATH=./data/natural-stone-network.db

# Comma-separated list of origins allowed to call the API (for the front end)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
